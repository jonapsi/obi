# Copiar a .env y cambiar las contraseñas. .env nunca se sube al repositorio.

# --- Postgres (docker compose) ---
# Superusuario del contenedor: solo lo usa el script de inicio.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambia-esto-superuser

DB_NAME=obi
DB_HOST=localhost
DB_PORT=5432

# Propietario de las tablas: migraciones y tests.
DB_OWNER_USER=obi_owner
DB_OWNER_PASSWORD=cambia-esto-owner

# Usuario de la aplicación: runserver y producción.
DB_APP_USER=obi_app
DB_APP_PASSWORD=cambia-esto-app

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esto
DJANGO_DEBUG=True
